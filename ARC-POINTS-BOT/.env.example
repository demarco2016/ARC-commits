ARC_EMAIL=your_email@example.com
ARC_PASSWORD=your_password_here

# Optional: proxy for anti-detection (http/socks5)
ARC_PROXY=http://user:pass@ip:port

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Optional: session file path (default: ./session.json)
ARC_SESSION_FILE=
